rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'admin';
    }

    function visitorsEnabled() {
      return exists(/databases/$(database)/documents/public_content/portal_settings)
        && get(/databases/$(database)/documents/public_content/portal_settings).data.visitor_enabled == true;
    }

    // Exact document-name allowlist matching publisher's 8 services.
    function publicDocumentName(id) {
      return id.matches('^hazm_(clock|compass|pd|family|plan|activities|safety|quality)_(manifest|part_[0-9]{3})$');
    }

    match /admins/{userId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /public_content/portal_settings {
      allow get: if true;
      allow list: if false;
      allow write: if isAdmin();
    }

    match /public_content/{documentId} {
      allow get: if publicDocumentName(documentId) && (isAdmin() || visitorsEnabled());
      allow list: if false;
      allow write: if isAdmin() && publicDocumentName(documentId);
    }

    match /private_data/{document=**} {
      allow read, write: if isAdmin();
    }

    match /supervisory_visits/{document=**} {
      allow read, write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
